# =============================================================================
# Amnezia Web Panel — example environment.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# ---- Secrets (REQUIRED in production) ---------------------------------------
# FastAPI session signing key. Must be stable across restarts or all
# sessions are invalidated. Minimum 32 bytes of random data (hex/urlsafe ok).
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Fernet key used to encrypt SSH passwords / private keys at rest in data.json.
# Generate ONCE with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you lose this key, encrypted secrets cannot be recovered. Back it up.
MASTER_KEY=

# ---- Dev mode ---------------------------------------------------------------
# Set to 1 ONLY for local development. Disables fail-fast checks on missing
# SECRET_KEY / MASTER_KEY (synthesizes throwaway values instead).
# Never enable in production or via a public tunnel.
AWP_DEV=1

# ---- Networking -------------------------------------------------------------
# Host port the panel listens on inside the container (mapped in compose).
APP_PORT=5000

# Comma-separated list of allowed Host header values. Any other Host is
# rejected with 400 by TrustedHostMiddleware. Use your tunnel domain here.
# Example: TRUSTED_HOSTS=panel.example.com,localhost,127.0.0.1
TRUSTED_HOSTS=localhost,127.0.0.1

# ---- Session cookie ---------------------------------------------------------
# https_only (Secure flag) — set true when serving over HTTPS/tunnel.
SESSION_COOKIE_SECURE=false
# SameSite policy: lax | strict | none
SESSION_COOKIE_SAMESITE=lax

# ---- Rate limiting (slowapi) ------------------------------------------------
# Format: "<count>/<period>", e.g. "5/minute".
LOGIN_RATE_LIMIT=5/minute
SHARE_RATE_LIMIT=10/minute
CAPTCHA_RATE_LIMIT=30/minute

# ---- Automatic data.json backups -------------------------------------------
# Interval between automatic backups, in hours. 0 disables.
BACKUP_INTERVAL_HOURS=6
# How many backups to keep (oldest pruned first).
BACKUP_KEEP_COUNT=14
